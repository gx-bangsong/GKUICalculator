<?xml version="1.0" encoding="utf-8"?>
<!--
    The track of the single mode pill. This drawable is applied to the scrolling container itself
    so the pill's outline stays fixed while its segments scroll through it, which is only safe if
    the radius matches what a selected segment paints (@drawable/mode_segment_background, 22dp):
    clipToOutline cuts to this outline, so a smaller radius here would visibly flatten the
    selected segment's stadium as it passes the pill's edge.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/calculator_chip_background" />
    <corners android:radius="22dp" />
</shape>
