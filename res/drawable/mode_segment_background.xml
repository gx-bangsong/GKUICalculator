<?xml version="1.0" encoding="utf-8"?>
<!--
    One segment of the 123 / fx / ⇄ control. Unchecked segments are transparent so the group's
    track shows through; the selected segment is an opaque stadium in the warm olive used by
    Google Calculator v10. TextViews are not checkable, so the state is driven by
    setSelected() rather than state_checked.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/mode_segment_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/calculator_chip_selected_background" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
