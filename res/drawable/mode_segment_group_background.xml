<?xml version="1.0" encoding="utf-8"?>
<!--
    The single "track" that the three mode segments sit on. The checked segment paints its own
    darker surface (see @drawable/mode_segment_background) on top of this track, which is how
    Google Calculator v10 renders 123 / fx / ⇄. Uses a plain <shape> rather than a ripple
    because a ripple's mask ignores rounded-corner clipping on some API levels.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/calculator_chip_background" />
    <corners android:radius="22dp" />
</shape>
