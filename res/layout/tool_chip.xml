<?xml version="1.0" encoding="utf-8"?>
<!-- A compact, filter-style tool tab. Checked state is driven by ToolBarView. -->
<com.google.android.material.chip.Chip
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.Chip.Filter"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="true"
    android:textSize="13sp"
    app:checkedIcon="@null"
    app:chipBackgroundColor="@color/calculator_chip_background_states"
    app:chipCornerRadius="20dp"
    app:chipMinHeight="36dp"
    app:chipStartPadding="9dp"
    app:chipEndPadding="9dp"
    app:chipStrokeWidth="0dp"
    android:textColor="@color/calculator_chip_text_states"
    app:ensureMinTouchTargetSize="false" />
