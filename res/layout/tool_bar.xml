<?xml version="1.0" encoding="utf-8"?>
<!--
    Compact mode strip immediately above the keypad: scientific toggle, tool pills, overflow.
    Converter category pills stay in the converter's display and never open a full-screen picker.
-->
<com.android.calculator2.tools.ui.ToolBarView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tool_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/display_background_color"
    android:paddingStart="@dimen/tool_bar_horizontal_padding"
    android:paddingEnd="@dimen/tool_bar_horizontal_padding"
    android:paddingTop="@dimen/tool_bar_vertical_padding"
    android:paddingBottom="@dimen/tool_bar_vertical_padding">

    <!-- Scientific-pad toggle uses the same compact pill language as the mode tabs. -->
    <TextView
        android:id="@+id/scientific_toggle"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/scientific_toggle_background"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:minWidth="44dp"
        android:onClick="onScientificToggleClick"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textAllCaps="false"
        android:textColor="@color/calculator_chip_text"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:id="@+id/tool_chips_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tool_chips_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tool_more_button"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/tool_more"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:backgroundTint="@color/display_background_color"
        app:icon="@drawable/ic_tool_more"
        app:iconTint="@color/calculator_key_text" />

</com.android.calculator2.tools.ui.ToolBarView>
