<?xml version="1.0" encoding="utf-8"?>
<!--
    Mode strip immediately above the keypad, modelled on Google Calculator v10 and extended
    to every tool this app ships.

    The strip is exactly ONE pill and nothing else: 123 / fx / ⇄ followed by one icon-only
    segment per tool. The pill spans the full width of the strip and its segments share that
    width equally, so every mode is visible inside the pill at once, with both rounded ends on
    screen. There is no trailing button: every tool is already a segment.
-->
<com.android.calculator2.tools.ui.ToolBarView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tool_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/display_background_color"
    android:paddingStart="@dimen/tool_bar_horizontal_padding"
    android:paddingEnd="@dimen/tool_bar_horizontal_padding"
    android:paddingTop="@dimen/tool_bar_vertical_padding"
    android:paddingBottom="@dimen/tool_bar_vertical_padding">

    <!--
        The one pill. The scroll view carries the track background and the rounded-corner
        clipping. It fills the strip, and fillViewport stretches the segment row to the same
        width, so the weighted segments divide the whole pill between them. Scrolling is only a
        fallback for a window too narrow to fit every segment at its minimum width.
    -->
    <HorizontalScrollView
        android:id="@+id/mode_segments_scroll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mode_segment_height"
        android:background="@drawable/mode_segment_track_background"
        android:clipToOutline="true"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mode_segments"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mode_segment_basic"
                style="@style/ModeSegment"
                android:contentDescription="@string/desc_mode_basic"
                android:onClick="onModeSegmentClick"
                android:text="@string/mode_segment_basic" />

            <TextView
                android:id="@+id/mode_segment_scientific"
                style="@style/ModeSegment"
                android:contentDescription="@string/desc_mode_scientific"
                android:onClick="onModeSegmentClick"
                android:text="@string/mode_segment_scientific" />

            <TextView
                android:id="@+id/mode_segment_convert"
                style="@style/ModeSegment"
                android:contentDescription="@string/desc_mode_convert"
                android:onClick="onModeSegmentClick"
                android:text="@string/mode_segment_convert" />
            <!--
                The tool segments are appended here at runtime by ToolBarView.render(), inside
                the same LinearLayout, so they are part of this pill and share its background,
                corner radius and scrolling.
            -->
        </LinearLayout>

    </HorizontalScrollView>

</com.android.calculator2.tools.ui.ToolBarView>
