<?xml version="1.0" encoding="utf-8"?>
<!--
    Compact mode strip immediately above the keypad, modelled on Google Calculator v10:
    a single segmented control (123 / fx / ⇄) that both selects the active surface
    (calculator / scientific pad / converters) and shows it, followed by the tool pills
    only while a life-calculation tool is active, and the overflow button.
-->
<com.android.calculator2.tools.ui.ToolBarView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tool_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/display_background_color"
    android:paddingStart="@dimen/tool_bar_horizontal_padding"
    android:paddingEnd="@dimen/tool_bar_horizontal_padding"
    android:paddingTop="@dimen/tool_bar_vertical_padding"
    android:paddingBottom="@dimen/tool_bar_vertical_padding">

    <!-- Segmented control: 123 (standard keypad) / fx (scientific) / ⇄ (converters). -->
    <LinearLayout
        android:id="@+id/mode_segments"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/mode_segment_height"
        android:background="@drawable/mode_segment_group_background"
        android:clipToOutline="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mode_segment_basic"
            style="@style/ModeSegment"
            android:contentDescription="@string/desc_mode_basic"
            android:onClick="onModeSegmentClick"
            android:text="@string/mode_segment_basic" />

        <TextView
            android:id="@+id/mode_segment_scientific"
            style="@style/ModeSegment"
            android:contentDescription="@string/desc_mode_scientific"
            android:onClick="onModeSegmentClick"
            android:text="@string/mode_segment_scientific" />

        <TextView
            android:id="@+id/mode_segment_convert"
            style="@style/ModeSegment"
            android:contentDescription="@string/desc_mode_convert"
            android:onClick="onModeSegmentClick"
            android:text="@string/mode_segment_convert" />

    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/tool_chips_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tool_chips_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tool_more_button"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/tool_more"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:backgroundTint="@color/display_background_color"
        app:icon="@drawable/ic_tool_more"
        app:iconTint="@color/calculator_key_text" />

</com.android.calculator2.tools.ui.ToolBarView>
