<?xml version="1.0" encoding="utf-8"?>
<!--
    Mode strip immediately above the keypad, modelled on Google Calculator v10 and extended
    to every tool this app ships.

    There is exactly ONE pill: a single scrolling track that opens with 123 / fx / ⇄ and then
    continues with one icon-only segment per tool. The tool icons are not a second control
    sitting next to the pill — they are the right-hand end of the same pill, so the whole thing
    reads as one long segmented control that happens to be too wide for a phone and therefore
    scrolls horizontally as a unit.

    The track is the single place a surface is selected. The trailing button opens the full tool
    panel and is deliberately outside the pill, because it is a menu, not a mode.
-->
<com.android.calculator2.tools.ui.ToolBarView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tool_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/display_background_color"
    android:paddingStart="@dimen/tool_bar_horizontal_padding"
    android:paddingEnd="@dimen/tool_bar_horizontal_padding"
    android:paddingTop="@dimen/tool_bar_vertical_padding"
    android:paddingBottom="@dimen/tool_bar_vertical_padding">

    <!--
        The one pill. The scroll view carries the track background and the rounded-corner
        clipping, and it is sized to its content up to the space available: a narrow phone
        scrolls the whole pill, a wide screen shows it whole. Because the background lives on
        the scroller rather than on the inner LinearLayout, the pill's outline stays fixed while
        its contents scroll through it.

        wrap_content rather than a weighted 0dp on purpose: the pill should stop where its
        segments stop, so a tablet shows a compact control that is anchored to the start instead
        of a track stretched across unused space. The overflow button after it is not weighted
        either, so the pair stays left-aligned.
    -->
    <HorizontalScrollView
        android:id="@+id/mode_segments_scroll"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/mode_segment_height"
        android:background="@drawable/mode_segment_track_background"
        android:clipToOutline="true"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mode_segments"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mode_segment_basic"
                style="@style/ModeSegment"
                android:contentDescription="@string/desc_mode_basic"
                android:onClick="onModeSegmentClick"
                android:text="@string/mode_segment_basic" />

            <TextView
                android:id="@+id/mode_segment_scientific"
                style="@style/ModeSegment"
                android:contentDescription="@string/desc_mode_scientific"
                android:onClick="onModeSegmentClick"
                android:text="@string/mode_segment_scientific" />

            <TextView
                android:id="@+id/mode_segment_convert"
                style="@style/ModeSegment"
                android:contentDescription="@string/desc_mode_convert"
                android:onClick="onModeSegmentClick"
                android:text="@string/mode_segment_convert" />
            <!--
                The tool segments are appended here at runtime by ToolBarView.render(), inside
                the same LinearLayout, so they are part of this pill and share its background,
                corner radius and scrolling.
            -->
        </LinearLayout>

    </HorizontalScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tool_more_button"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/tool_more"
        android:layout_gravity="center_vertical"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:backgroundTint="@color/display_background_color"
        app:icon="@drawable/ic_tool_more"
        app:iconTint="@color/calculator_key_text" />

</com.android.calculator2.tools.ui.ToolBarView>
