<?xml version="1.0" encoding="utf-8"?>
<!-- Currency: from/to as tappable TextViews (tap to pick currency via popup), swap, update time. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/formula_padding_start"
    android:paddingEnd="@dimen/formula_padding_end"
    android:paddingTop="@dimen/tool_bar_vertical_padding"
    android:paddingBottom="@dimen/tool_bar_vertical_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/currency_from"
            style="@style/ToolFieldStyle"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/tool_chip_spacing"
            android:paddingEnd="@dimen/tool_chip_spacing"
            android:text="→"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:id="@+id/currency_to"
            style="@style/ToolFieldStyle"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/currency_swap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tool_chip_spacing"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:minWidth="36dp"
            android:minHeight="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_unit_swap"
            android:contentDescription="@string/unit_swap_desc" />
    </LinearLayout>

    <TextView
        android:id="@+id/currency_update_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingTop="1dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?colorOnSurfaceVariant"
        android:text="@string/currency_loading" />

</LinearLayout>
