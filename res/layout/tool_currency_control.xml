<?xml version="1.0" encoding="utf-8"?>
<!-- Currency: number + tappable unit side by side (iOS-style), swap, update time. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/formula_padding_start"
    android:paddingEnd="@dimen/formula_padding_end"
    android:paddingTop="@dimen/tool_bar_vertical_padding"
    android:paddingBottom="@dimen/tool_bar_vertical_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Input number (updates as you type) -->
        <TextView
            android:id="@+id/currency_input_text"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?colorOnSurface" />

        <!-- From currency (tappable) -->
        <TextView
            android:id="@+id/currency_from"
            style="@style/ToolFieldStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:minWidth="56dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="→"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <!-- Result number (updates on currency/rate change) -->
        <TextView
            android:id="@+id/currency_result_text"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?colorOnSurface" />

        <!-- To currency (tappable) -->
        <TextView
            android:id="@+id/currency_to"
            style="@style/ToolFieldStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:minWidth="56dp" />

        <ImageButton
            android:id="@+id/currency_swap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:minWidth="32dp"
            android:minHeight="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_unit_swap"
            android:contentDescription="@string/unit_swap_desc" />
    </LinearLayout>

    <TextView
        android:id="@+id/currency_update_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingTop="1dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?colorOnSurfaceVariant"
        android:text="@string/currency_loading" />

</LinearLayout>
