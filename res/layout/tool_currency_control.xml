<?xml version="1.0" encoding="utf-8"?>
<!-- Currency converter keeps the Google-style stacked amount rows but uses anchored currency menus. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/display_background_color"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/currency_from"
            style="@style/ToolDropdownStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:contentDescription="@string/currency_from_desc" />

        <TextView
            android:id="@+id/currency_input_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:includeFontPadding="false"
            android:textColor="@color/calculator_key_text"
            android:textSize="34sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/currency_swap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/unit_swap_desc"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_unit_swap"
            app:tint="@color/calculator_chip_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/calculator_display_divider" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/currency_to"
            style="@style/ToolDropdownStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:contentDescription="@string/currency_to_desc" />

        <TextView
            android:id="@+id/currency_result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:includeFontPadding="false"
            android:textColor="@color/display_result_text_color"
            android:textSize="34sp" />

    </LinearLayout>

    <!-- Optional second conversion output, toggled from the calculator overflow menu. -->
    <LinearLayout
        android:id="@+id/currency_secondary_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/currency_to_2"
            style="@style/ToolDropdownStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:contentDescription="@string/currency_second_to_desc" />

        <TextView
            android:id="@+id/currency_result_2_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:includeFontPadding="false"
            android:textColor="@color/display_result_text_color"
            android:textSize="28sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/currency_update_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingTop="4dp"
        android:text="@string/currency_loading"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/calculator_chip_text" />

</LinearLayout>
