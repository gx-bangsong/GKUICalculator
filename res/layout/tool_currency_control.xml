<?xml version="1.0" encoding="utf-8"?>
<!-- Currency: two rows, each with number + tappable unit. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/formula_padding_start"
    android:paddingEnd="@dimen/formula_padding_end"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Row 1: input number + from currency -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/currency_input_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?colorOnSurface" />

        <TextView
            android:id="@+id/currency_from"
            style="@style/ToolDropdownStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/currency_from_desc" />

        <!-- Placeholder view to align with Row 2's swap button -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Row 2: result number + to currency + swap -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/currency_result_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?colorOnSurface" />

        <TextView
            android:id="@+id/currency_to"
            style="@style/ToolDropdownStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/currency_to_desc" />

        <ImageButton
            android:id="@+id/currency_swap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_unit_swap"
            android:contentDescription="@string/unit_swap_desc"
            app:tint="?colorOnSurface" />
    </LinearLayout>

    <!-- Optional second conversion output, toggled from the activity overflow menu. -->
    <LinearLayout
        android:id="@+id/currency_secondary_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/currency_result_2_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:textColor="?colorOnSurface"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/currency_to_2"
            style="@style/ToolDropdownStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/currency_second_to_desc" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/currency_update_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingTop="2dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?colorOnSurfaceVariant"
        android:text="@string/currency_loading" />

</LinearLayout>
