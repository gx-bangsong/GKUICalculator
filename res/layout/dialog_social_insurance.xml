<?xml version="1.0" encoding="utf-8"?>
<!-- Five insurances and one fund, entered proportionally as six separate categories. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/si_base"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <EditText
            android:id="@+id/si_base_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/si_rates_hint"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?colorOnSurfaceVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/si_pension"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <EditText
            android:id="@+id/si_rate_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/si_medical"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <EditText
            android:id="@+id/si_rate_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/si_unemployment"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <EditText
            android:id="@+id/si_rate_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/si_injury"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <EditText
            android:id="@+id/si_rate_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/si_maternity"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <EditText
            android:id="@+id/si_rate_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/si_fund"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <EditText
            android:id="@+id/si_rate_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />
    </LinearLayout>
</ScrollView>
