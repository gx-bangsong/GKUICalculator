<?xml version="1.0" encoding="utf-8"?>
<!-- Unit Converter: three rows. Category row, Input row, and Result/Swap row. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/formula_padding_start"
    android:paddingEnd="@dimen/formula_padding_end"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Row 1: Category selection -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?colorOnSurfaceVariant"
            android:text="@string/tool_unit_category_label" />

        <TextView
            android:id="@+id/unit_category"
            style="@style/ToolUnitButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Placeholder view to match the horizontal alignment offset of swap button rows -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Row 2: Input number + from unit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/unit_input_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?colorOnSurface" />

        <TextView
            android:id="@+id/unit_from"
            style="@style/ToolUnitButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp" />

        <!-- Placeholder view to align with Row 3's swap button -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Row 3: Result number + to unit + swap -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/unit_result_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?colorOnSurface" />

        <TextView
            android:id="@+id/unit_to"
            style="@style/ToolUnitButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp" />

        <ImageButton
            android:id="@+id/unit_swap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_unit_swap"
            android:contentDescription="@string/unit_swap_desc"
            app:tint="?colorOnSurface" />
    </LinearLayout>

</LinearLayout>
