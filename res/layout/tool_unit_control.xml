<?xml version="1.0" encoding="utf-8"?>
<!--
    Inline unit converter: horizontally scrollable category pills, stacked source/result rows,
    and anchored unit menus. Category changes never replace the calculator with a full-screen list.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/display_background_color"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <HorizontalScrollView
        android:id="@+id/unit_category_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/unit_category_pills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:singleLine="true"
            app:singleSelection="true" />

    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/unit_from"
            style="@style/ToolDropdownStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:contentDescription="@string/unit_from_desc" />

        <TextView
            android:id="@+id/unit_input_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:includeFontPadding="false"
            android:textColor="@color/calculator_key_text"
            android:textSize="34sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/unit_swap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/unit_swap_desc"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_unit_swap"
            app:tint="@color/calculator_chip_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/calculator_display_divider" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/unit_to"
            style="@style/ToolDropdownStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:contentDescription="@string/unit_to_desc" />

        <TextView
            android:id="@+id/unit_result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:includeFontPadding="false"
            android:textColor="@color/display_result_text_color"
            android:textSize="34sp" />

    </LinearLayout>

    <!-- Optional second conversion output, toggled from the calculator overflow menu. -->
    <LinearLayout
        android:id="@+id/unit_secondary_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/unit_to_2"
            style="@style/ToolDropdownStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:contentDescription="@string/unit_second_to_desc" />

        <TextView
            android:id="@+id/unit_result_2_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:includeFontPadding="false"
            android:textColor="@color/display_result_text_color"
            android:textSize="28sp" />

    </LinearLayout>

</LinearLayout>
