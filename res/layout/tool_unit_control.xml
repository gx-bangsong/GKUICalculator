<?xml version="1.0" encoding="utf-8"?>
<!--
     Unit-converter control row, mounted by UnitConverterMode into tool_control_slot.
     [ category ] [ from ] [ swap ] [ to ]
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/formula_padding_start"
    android:paddingEnd="@dimen/formula_padding_end"
    android:paddingTop="@dimen/tool_bar_vertical_padding"
    android:paddingBottom="@dimen/tool_bar_vertical_padding">

    <Spinner
        android:id="@+id/unit_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:spinnerMode="dropdown" />

    <Spinner
        android:id="@+id/unit_from"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/tool_chip_spacing"
        android:spinnerMode="dropdown" />

    <ImageButton
        android:id="@+id/unit_swap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tool_chip_spacing"
        android:layout_marginEnd="@dimen/tool_chip_spacing"
        android:minWidth="@dimen/button_iconsize"
        android:minHeight="@dimen/button_iconsize"
        android:padding="@dimen/tool_bar_vertical_padding"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_unit_swap"
        android:contentDescription="@string/unit_swap_desc"
        app:tint="?colorOnSurface" />

    <Spinner
        android:id="@+id/unit_to"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:spinnerMode="dropdown" />

</LinearLayout>
