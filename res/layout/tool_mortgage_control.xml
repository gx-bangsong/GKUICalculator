<?xml version="1.0" encoding="utf-8"?>
<!-- Mortgage: 贷款额 (full) / 年利率 + 年限 (side by side) / 方式 = 3 rows -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/tool_bar_vertical_padding"
    android:paddingBottom="@dimen/tool_bar_vertical_padding">

    <TextView
        android:id="@+id/tool_field_0"
        style="@style/ToolFieldStyle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tool_field_1"
            style="@style/ToolFieldStyle"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tool_field_2"
            style="@style/ToolFieldStyle"
            android:layout_width="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/mortgage_method"
        style="@style/ToolFieldStyle"
        android:textColor="?colorOnSurfaceVariant" />

</LinearLayout>
