<?xml version="1.0" encoding="utf-8"?>
<!-- One content scroller is supplied by FieldToolViewport. No nested vertical ScrollView.
     Every field is a full-width, naturally measured row, including conditional fields. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:showDividers="middle"
    android:divider="?android:attr/listDivider">
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/mortgage_type_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:checkedButton="@id/mortgage_type_commercial"
        app:selectionRequired="true" app:singleSelection="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/mortgage_type_commercial"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="44dp"
            android:minWidth="0dp" app:minWidth="0dp"
            android:padding="0dp" android:text="@string/tool_mortgage_commercial" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/mortgage_type_fund"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="44dp"
            android:minWidth="0dp" app:minWidth="0dp"
            android:padding="0dp" android:text="@string/tool_mortgage_fund" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/mortgage_type_combined"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="44dp"
            android:minWidth="0dp" app:minWidth="0dp"
            android:padding="0dp" android:text="@string/tool_mortgage_combined" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/mortgage_basis_toggle"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="44dp" android:text="@string/tool_mortgage_benchmark" />
    <com.android.calculator2.tools.ToolFieldEditText
        android:id="@+id/tool_field_0"
        style="@style/MortgageFieldStyle"
        android:inputType="textMultiLine" android:singleLine="false"
        android:scrollHorizontally="false" />
    <com.android.calculator2.tools.ToolFieldEditText
        android:id="@+id/tool_field_1"
        style="@style/MortgageFieldStyle"
        android:inputType="textMultiLine" android:singleLine="false"
        android:scrollHorizontally="false" />
    <com.android.calculator2.tools.ToolFieldEditText
        android:id="@+id/tool_field_2"
        style="@style/MortgageFieldStyle"
        android:inputType="textMultiLine" android:singleLine="false"
        android:scrollHorizontally="false" />
    <com.android.calculator2.tools.ToolFieldEditText
        android:id="@+id/tool_field_3"
        style="@style/MortgageFieldStyle"
        android:inputType="textMultiLine" android:singleLine="false"
        android:scrollHorizontally="false" android:visibility="gone" />
    <com.android.calculator2.tools.ToolFieldEditText
        android:id="@+id/tool_field_4"
        style="@style/MortgageFieldStyle"
        android:inputType="textMultiLine" android:singleLine="false"
        android:scrollHorizontally="false" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/mortgage_method"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:textSize="16sp"
        android:paddingStart="12dp" android:paddingEnd="12dp" />
</LinearLayout>
