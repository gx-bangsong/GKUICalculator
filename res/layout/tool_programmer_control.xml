<?xml version="1.0" encoding="utf-8"?>
<!--
     Programmer: like the unit converter, two numeral systems one above the other, each with a
     anchored radix menu alongside. A swap action preserves the register value. The width / signedness conversion
     options live in the activity overflow menu.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/formula_padding_start"
    android:paddingEnd="@dimen/formula_padding_end"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/programmer_input_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="horizontal">
        <com.android.calculator2.tools.ToolFieldEditText
            android:id="@+id/programmer_value_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:inputType="text"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textIsSelectable="true" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/programmer_chip_in"
            style="@style/ToolDropdownStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="64dp"
            android:text="@string/programmer_dec" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/programmer_swap"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/programmer_swap"
        android:padding="12dp"
        android:src="@drawable/ic_unit_swap"
        android:tint="?colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/programmer_output_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="horizontal">
        <com.android.calculator2.tools.ToolOutputTextView
            android:id="@+id/programmer_value_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:cursorVisible="false"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?colorOnSurfaceVariant"
            android:textIsSelectable="true" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/programmer_chip_out"
            style="@style/ToolDropdownStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="64dp"
            android:text="@string/programmer_hex" />
    </LinearLayout>

    <com.android.calculator2.tools.ToolOutputTextView
        android:id="@+id/programmer_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <com.android.calculator2.tools.ToolOutputTextView
        android:id="@+id/programmer_width_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingTop="2dp"
        android:text="@string/programmer_signed_64"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?colorOnSurfaceVariant" />

</LinearLayout>

</ScrollView>
