<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/formula_padding_start"
    android:paddingEnd="@dimen/formula_padding_end"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/programmer_base_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:checkedButton="@id/programmer_base_dec"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/programmer_base_hex"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/programmer_hex" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/programmer_base_dec"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/programmer_dec" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/programmer_base_oct"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/programmer_oct" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/programmer_base_bin"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/programmer_bin" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingTop="2dp"
        android:text="@string/programmer_signed_64"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?colorOnSurfaceVariant" />

</LinearLayout>
