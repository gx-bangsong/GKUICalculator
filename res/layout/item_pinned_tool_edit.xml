<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp">

    <!-- Shake animation will be applied to this Chip in code -->
    <com.google.android.material.chip.Chip
        android:id="@+id/chip_tool"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:chipSurfaceColor="?attr/colorSurfaceContainerHigh"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Remove Badge/Icon overlapping the top-right corner of the chip -->
    <ImageView
        android:id="@+id/btn_remove"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_close"
        android:background="@drawable/bg_circle_surface"
        android:contentDescription="Remove Tool"
        android:elevation="2dp"
        app:tint="?attr/colorError"
        app:layout_constraintTop_toTopOf="@id/chip_tool"
        app:layout_constraintEnd_toEndOf="@id/chip_tool"
        app:layout_constraintCircle="@id/chip_tool"
        app:layout_constraintCircleAngle="45"
        app:layout_constraintCircleRadius="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
