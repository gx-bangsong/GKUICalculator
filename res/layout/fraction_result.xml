<?xml version="1.0" encoding="utf-8"?>
<com.android.calculator2.FractionResultView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fraction_viewport"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    android:focusable="false"
    android:scrollbars="vertical">
    <com.android.calculator2.FractionResultText
        android:id="@+id/fraction_result"
        style="@style/DisplayTextStyle.Result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:textColor="@color/display_result_text_color"
        android:textIsSelectable="false"
        android:cursorVisible="false"
        android:focusable="false"
        android:longClickable="true" />
</com.android.calculator2.FractionResultView>
