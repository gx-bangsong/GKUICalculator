<?xml version="1.0" encoding="utf-8"?>
<!--
     Tool "more" overlay. Root is ToolPanelOverlay (ConstraintLayout); the panel card sits below
     a guideline so it covers only the pad area (not the whole screen). Transparent above the
     guideline lets the display show through. Starts GONE.
-->
<com.android.calculator2.tools.ui.ToolPanelOverlay
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tool_panel_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/tool_panel_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.40" />

    <LinearLayout
        android:id="@+id/tool_panel_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/tool_panel_background"
        android:elevation="@dimen/tool_panel_elevation"
        android:orientation="vertical"
        android:paddingStart="@dimen/tool_panel_horizontal_padding"
        android:paddingEnd="@dimen/tool_panel_horizontal_padding"
        android:paddingTop="@dimen/tool_panel_top_padding"
        android:paddingBottom="@dimen/tool_panel_bottom_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tool_panel_guide">

        <TextView
            android:id="@+id/tool_panel_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/tool_panel_title_padding_bottom"
            android:text="@string/tool_panel_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?colorOnSurface" />

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/tool_panel_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:useDefaultMargins="true" />

        <TextView
            android:id="@+id/tool_panel_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/tool_panel_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?colorOnSurfaceVariant" />

    </LinearLayout>

</com.android.calculator2.tools.ui.ToolPanelOverlay>
