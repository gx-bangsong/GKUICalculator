<?xml version="1.0" encoding="utf-8"?>
<!-- The seven 专项附加扣除 categories; the dialog reduces them to one monthly total. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ded_children"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/ded_edu_children"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAutofill="no"
                android:inputType="number" />

            <Spinner
                android:id="@+id/ded_edu_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/ded_continuing"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <Spinner
            android:id="@+id/ded_continuing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/ded_medical"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <EditText
            android:id="@+id/ded_medical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <CheckBox
            android:id="@+id/ded_mortgage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/ded_mortgage" />

        <Spinner
            android:id="@+id/ded_mortgage_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/ded_rent"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <Spinner
            android:id="@+id/ded_rent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="@string/ded_rent_mortgage_hint"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?colorOnSurfaceVariant" />

        <CheckBox
            android:id="@+id/ded_elderly_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/ded_elderly_only" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ded_elderly_shared"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <EditText
            android:id="@+id/ded_elderly_shared"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/ded_infant"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/ded_infant_children"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAutofill="no"
                android:inputType="number" />

            <Spinner
                android:id="@+id/ded_infant_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
