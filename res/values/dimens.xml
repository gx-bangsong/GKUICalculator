<resources>

    <dimen name="history_divider_padding">14dip</dimen>

    <dimen name="history_item_text_padding_top">8dip</dimen>
    <dimen name="history_item_text_padding_bottom">16dip</dimen>

    <dimen name="drag_handle_margin">8dp</dimen>
    <dimen name="display_corner_radius">16dp</dimen>

    <!-- Dimens for display formula. -->
    <dimen name="formula_padding_top">16dip</dimen>
    <dimen name="formula_padding_bottom">8dip</dimen>
    <dimen name="formula_padding_start">16dip</dimen>
    <dimen name="formula_padding_end">16dip</dimen>
    <dimen name="formula_min_textsize">32dip</dimen>
    <dimen name="formula_max_textsize">48dip</dimen>
    <dimen name="formula_step_textsize">8dip</dimen>

    <!-- Dimens for display result. -->
    <dimen name="result_padding_top">8dip</dimen>
    <dimen name="result_padding_bottom">32dip</dimen>
    <dimen name="result_padding_start">16dip</dimen>
    <dimen name="result_padding_end">16dip</dimen>
    <dimen name="result_textsize">32dip</dimen>

    <!-- Pads -->
    <dimen name="pads_horizontal_edge_padding">8dp</dimen>
    <dimen name="pads_vertical_edge_padding">8dp</dimen>
    <dimen name="pads_intra_padding">4dp</dimen>

    <!-- Buttons -->
    <dimen name="button_horizontal_margin">4dp</dimen>
    <!-- Google Calculator v10 leaves ~4.3 dp between key rows. -->
    <dimen name="button_vertical_margin">2dp</dimen>
    <dimen name="button_small_horizontal_margin">2dp</dimen>
    <dimen name="button_iconsize">24dp</dimen>

    <!-- Label ink = key width x this scale, clamped to 0.42 x key height and to the max below.
         Digit key (96 dp wide): 20.2 sp, versus Google 24.7 dp. Scientific key (same width,
         48 dp tall): height clamp gives 20.2 sp as well, Google prints 15.3 dp, so the
         scientific style carries its own smaller scale in PadButtonStyle.Scientific. -->
    <item name="dimen_key_label_scale" format="float" type="dimen">0.21</item>
    <dimen name="key_label_max_textsize">26sp</dimen>
    <item name="dimen_key_label_scale_scientific" format="float" type="dimen">0.165</item>

    <!-- Scientific pad: flat pills with a small gutter, as in Google Calculator v10. -->
    <dimen name="scientific_key_corner_radius">10dp</dimen>
    <dimen name="scientific_key_horizontal_margin">2dp</dimen>
    <dimen name="scientific_key_vertical_margin">2dp</dimen>

    <!-- 123 / fx / ⇄ segmented control. -->
    <dimen name="mode_segment_height">44dp</dimen>
    <dimen name="mode_segment_min_width">40dp</dimen>
    <dimen name="mode_segment_padding">16dp</dimen>
    <!-- Icon-only segments in the same track: a 24 dp glyph centred in a square slot. -->
    <dimen name="mode_segment_icon_size">40dp</dimen>
    <dimen name="mode_segment_icon_inset">8dp</dimen>

    <!-- Tool bar -->
    <dimen name="tool_bar_horizontal_padding">4dp</dimen>
    <dimen name="tool_bar_vertical_padding">2dp</dimen>
    <dimen name="tool_chip_spacing">4dp</dimen>

    <!-- Tool-mode display: labeled outputs (tax / BMI / mortgage) must not use the
         calculator's huge auto-sized formula. -->
    <dimen name="tool_formula_max_textsize">32sp</dimen>
    <dimen name="tool_result_textsize">14sp</dimen>
    <!-- Chinese-uppercase-numerals (中文大写数字) output: CJK needs a slightly larger size, and
         it may shrink to the minimum so a long amount is still shown in full. -->
    <dimen name="tool_uppercase_result_textsize">16sp</dimen>
    <dimen name="tool_uppercase_result_min_textsize">10sp</dimen>

    <!-- Tool overlay panel -->
    <dimen name="tool_panel_corner_radius">20dp</dimen>
    <dimen name="tool_panel_elevation">6dp</dimen>
    <dimen name="tool_panel_slide">64dp</dimen>
    <dimen name="tool_panel_top_padding">16dp</dimen>
    <dimen name="tool_panel_bottom_padding">16dp</dimen>
    <dimen name="tool_panel_horizontal_padding">8dp</dimen>
    <dimen name="tool_panel_title_padding_bottom">8dp</dimen>
    <dimen name="tool_panel_item_padding">12dp</dimen>
    <dimen name="tool_panel_item_icon">28dp</dimen>
    <dimen name="tool_panel_item_text_margin_top">6dp</dimen>
</resources>
