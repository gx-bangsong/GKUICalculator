<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-FileCopyrightText: 2026 The GKUICalculator Project
     SPDX-License-Identifier: Apache-2.0

     A warm, low-contrast calculator palette inspired by the Google Calculator v10 preview.
     The key colors are explicit so the keypad stays visually consistent across wallpapers.
-->
<resources>

    <color name="history_background_color">#FFF2E3</color>
    <color name="display_background_color">#FFFBF4</color>

    <color name="display_formula_text_color">#FF29251E</color>
    <color name="display_result_text_color">#FF566642</color>
    <color name="display_result_exponent_text_color">#FF566642</color>

    <color name="tool_panel_background_color">#FFF4E9</color>
    <color name="tool_field_text_color">#FF29251E</color>

    <!-- Calculator key surfaces. -->
    <color name="calculator_key_number">#FFF0E8DF</color>
    <color name="calculator_key_action">#FFFFE2C0</color>
    <color name="calculator_key_operator">#FFF8DEBF</color>
    <color name="calculator_key_clear">#FFEEE8DF</color>
    <color name="calculator_key_equals">#FF506443</color>
    <color name="calculator_key_text">#FF29251E</color>
    <!-- Disabled key labels (programmer A-F outside hex, emptied keys, ...). -->
    <color name="calculator_key_text_disabled">#FF9A9184</color>
    <color name="calculator_key_text_on_accent">#FFFFFBF4</color>

    <!-- Filter/tool pills share the same checked state and warm ink. -->
    <color name="calculator_chip_background">#FFF2EADD</color>
    <color name="calculator_chip_text">#FF5B4E3B</color>
    <color name="calculator_chip_selected_background">#FF796849</color>
    <color name="calculator_chip_selected_text">#FFFFFBF4</color>
    <color name="calculator_unit_selector_background">#FFF1E8DC</color>
    <color name="calculator_unit_selector_text">#FF4A4338</color>
    <color name="calculator_display_divider">#FFE4DACB</color>

    <!-- 123 / fx / ⇄ segmented control: the track uses calculator_chip_background and the
         checked segment uses calculator_chip_selected_background. -->
    <color name="mode_segment_ripple">#33796849</color>

</resources>
